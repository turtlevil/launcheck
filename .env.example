# Copy this file to .env in the launchcheck_v4_1 folder. Keep .env PRIVATE.
# Persist this secret across restarts (e.g. `python -c "import secrets;print(secrets.token_urlsafe(40))"`)
LAUNCHCHECK_SESSION_SECRET=
# Mandatory for OAuth connections; generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=
LAUNCHCHECK_BASE_URL=http://127.0.0.1:8000
# Client credentials from *your own* Slack App configuration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Client credentials from Google Cloud Console, with Gmail API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: AI-generated role scenarios. If omitted, an explicit fictional demo is still available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Use secure cookies only when deployed behind HTTPS. Don't expose the prototype publicly.
LAUNCHCHECK_COOKIE_SECURE=0
